{
  "name": "@chienkq/workflow-core",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chienkq/pimsathon-g5-monorepo.git",
    "directory": "packages/workflow-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "check:format": "oxfmt --check . '!dist/**'",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "fix:format": "oxfmt . '!dist/**'",
    "fix:lint": "eslint . --fix"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
