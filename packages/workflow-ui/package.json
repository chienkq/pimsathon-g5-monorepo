{
  "name": "@chienkq/workflow-ui",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chienkq/pimsathon-g5-monorepo.git",
    "directory": "packages/workflow-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/styles && cp src/styles/workflow-ui.css dist/styles/workflow-ui.css && mkdir -p dist/assets/icons && (cp src/assets/icons/*.svg dist/assets/icons/ 2>/dev/null || true)",
    "dev": "node scripts/watch-assets.mjs & tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build",
    "check:format": "oxfmt --check . '!dist/**'",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "fix:format": "oxfmt . '!dist/**'",
    "fix:lint": "eslint . --fix"
  },
  "dependencies": {
    "@chienkq/workflow-core": "workspace:*",
    "@xyflow/react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
